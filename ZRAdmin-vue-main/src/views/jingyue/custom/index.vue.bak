<template>
  <div class="jy-custom">
    <div class="page-bar">
      <h1>销售定制</h1>
      <div class="bar-actions">
        <el-button plain @click="router.push('/business/custom-refund')">定金退回</el-button>
        <el-button v-hasPermi="['jingyue:custom:add']" type="primary" @click="openEditor">收取定金</el-button>
      </div>
    </div>

    <section class="filter-line">
      <el-date-picker v-model="dateRange" type="daterange" value-format="YYYY-MM-DD" range-separator="至" start-placeholder="开始日期" end-placeholder="结束日期" unlink-panels clearable @change="search" />
      <el-input v-model="query.keyword" clearable placeholder="单号 / 客户 / 手机 / 货品" @keyup.enter="search" @clear="search" />
      <el-select v-model="query.status" clearable placeholder="全部状态" @change="search">
        <el-option v-for="item in statusOptions" :key="item.value" :label="item.label" :value="item.value" />
      </el-select>
      <el-button type="primary" plain @click="search">查询</el-button>
      <span class="count">{{ total }} 张</span>
    </section>

    <section class="sheet">
      <el-table v-loading="loading" :data="rows" height="100%" empty-text="没有定制单" @row-click="openDetail">
        <el-table-column label="定制单号" min-width="150"><template #default="{ row }"><b>{{ row.customNo }}</b></template></el-table-column>
        <el-table-column label="日期" width="110" align="center"><template #default="{ row }">{{ dateText(row.customDate) }}</template></el-table-column>
        <el-table-column label="客户" min-width="140"><template #default="{ row }"><div class="stack"><b>{{ row.customerName || '未留姓名' }}</b><small>{{ row.customerPhone || '无手机号' }}</small></div></template></el-table-column>
        <el-table-column label="定制货品" min-width="180"><template #default="{ row }"><div class="stack"><b>{{ row.goodsName }}</b><small>{{ metaText(row) }}</small></div></template></el-table-column>
        <el-table-column label="定金" width="100" align="right"><template #default="{ row }">¥{{ money(row.depositAmount) }}</template></el-table-column>
        <el-table-column label="已对冲" width="100" align="right"><template #default="{ row }">¥{{ money(row.offsetAmount) }}</template></el-table-column>
        <el-table-column label="已退" width="90" align="right"><template #default="{ row }">¥{{ money(row.refundAmount) }}</template></el-table-column>
        <el-table-column label="剩余" width="100" align="right"><template #default="{ row }"><b class="remain">¥{{ money(row.remainAmount) }}</b></template></el-table-column>
        <el-table-column label="状态" width="96" align="center"><template #default="{ row }"><el-tag size="small" effect="plain" :type="statusType(row.status)">{{ statusText(row.status) }}</el-tag></template></el-table-column>
      </el-table>
      <div class="pager">
        <el-pagination v-model:current-page="query.pageNum" v-model:page-size="query.pageSize" :total="total" :page-sizes="[10, 20, 50]" layout="total, sizes, prev, pager, next" background small @size-change="load" @current-change="load" />
      </div>
    </section>

    <el-dialog v-model="editor" title="收取定金" width="680px" append-to-body destroy-on-close>
      <el-form ref="formRef" :model="form" :rules="rules" label-width="88px">
        <div class="form-grid">
          <el-form-item label="客户姓名" prop="customerName"><el-input v-model="form.customerName" maxlength="50" placeholder="回车识别会员" @keyup.enter="identify" /></el-form-item>
          <el-form-item label="手机号码"><el-input v-model="form.customerPhone" maxlength="30" placeholder="回车识别会员" @keyup.enter="identify" /></el-form-item>
          <el-form-item label="性别">
            <el-radio-group v-model="form.customerSex">
              <el-radio-button :value="0">未知</el-radio-button>
              <el-radio-button :value="1">先生</el-radio-button>
              <el-radio-button :value="2">女士</el-radio-button>
            </el-radio-group>
          </el-form-item>
          <el-form-item label="识别">
            <el-tag v-if="form.memberId" type="success" effect="plain">库内会员</el-tag>
            <el-tag v-else type="info" effect="plain">未绑定会员</el-tag>
          </el-form-item>
          <el-form-item label="定制货品" prop="goodsName" class="span-2"><el-input v-model="form.goodsName" maxlength="100" placeholder="例如：红宝石手链，按客样改圈口" /></el-form-item>
          <el-form-item label="款式大类">
            <el-select v-model="form.styleParentId" clearable placeholder="选择大类" @change="form.styleItemId = null">
              <el-option v-for="item in styleParents" :key="item.id" :label="item.itemName" :value="item.id" />
            </el-select>
          </el-form-item>
          <el-form-item label="款式分类">
            <el-select v-model="form.styleItemId" clearable :disabled="!form.styleParentId" placeholder="选择二级分类">
              <el-option v-for="item in styleChildren" :key="item.id" :label="item.itemName" :value="item.id" />
            </el-select>
          </el-form-item>
          <el-form-item label="材质">
            <el-select v-model="form.materialItemId" clearable placeholder="选择材质"><el-option v-for="item in materials" :key="item.id" :label="item.itemName" :value="item.id" /></el-select>
          </el-form-item>
          <el-form-item label="金属成色">
            <el-select v-model="form.metalItemId" clearable placeholder="选择成色"><el-option v-for="item in metals" :key="item.id" :label="item.itemName" :value="item.id" /></el-select>
          </el-form-item>
          <el-form-item label="克重"><el-input-number v-model="form.weight" :min="0" :precision="3" controls-position="right" /></el-form-item>
          <el-form-item label="预计售价"><el-input-number v-model="form.expectPrice" :min="0" :precision="2" controls-position="right" /></el-form-item>
          <el-form-item label="收取定金" prop="depositAmount"><el-input-number v-model="form.depositAmount" :min="0.01" :precision="2" controls-position="right" /></el-form-item>
          <el-form-item label="定制日期"><el-date-picker v-model="form.customDate" type="date" value-format="YYYY-MM-DD" /></el-form-item>
          <el-form-item label="备注" class="span-2"><el-input v-model="form.remark" maxlength="200" placeholder="工期、改款要求或取货约定" /></el-form-item>
        </div>
      </el-form>
      <template #footer>
        <el-button @click="editor = false">取消</el-button>
        <el-button type="primary" :loading="saving" @click="submit">保存并收定金</el-button>
      </template>
    </el-dialog>

    <el-drawer v-model="detailOpen" title="定金流水" size="420px">
      <template v-if="detail">
        <div class="detail-head">
          <b>{{ detail.customNo }}</b>
          <span>{{ detail.customerName }} · 剩余 ¥{{ money(detail.remainAmount) }}</span>
        </div>
        <el-timeline>
          <el-timeline-item v-for="item in detail.ledgers || []" :key="item.id" :timestamp="dateTime(item.bizTime)">
            <b>{{ ledgerText(item.changeType) }} {{ money(item.amount) }}</b>
            <p>{{ item.remark || '无备注' }} · 余额 ¥{{ money(item.balanceAfter) }}</p>
          </el-timeline-item>
        </el-timeline>
        <el-empty v-if="!(detail.ledgers || []).length" description="暂无流水" />
      </template>
    </el-drawer>
  </div>
</template>

<script setup name="JyCustom">
import { computed, onMounted, reactive, ref } from 'vue'
import { useRouter } from 'vue-router'
import { ElMessage } from 'element-plus'
import { getCustom, listCustom, saveCustom } from '@/api/jingyue/custom'
import { lookupOptions } from '@/api/jingyue/lookup'
import { matchSaleCustomer } from '@/api/jingyue/sale'

const router = useRouter()
const loading = ref(false)
const saving = ref(false)
const editor = ref(false)
const detailOpen = ref(false)
const rows = ref([])
const total = ref(0)
const dateRange = ref([])
const styles = ref([])
const materials = ref([])
const metals = ref([])
const detail = ref(null)
const formRef = ref()
const query = reactive({ pageNum: 1, pageSize: 20, keyword: '', status: null, beginTime: null, endTime: null })
const form = reactive(blankForm())
const rules = {
  customerName: [{ required: true, message: '请填写客户姓名', trigger: 'blur' }],
  goodsName: [{ required: true, message: '请填写定制货品', trigger: 'blur' }],
  depositAmount: [{ required: true, message: '请填写定金', trigger: 'change' }]
}
const statusOptions = [
  { value: 1, label: '已收定金' },
  { value: 2, label: '部分处理' },
  { value: 3, label: '已对冲完' },
  { value: 8, label: '已退清' },
  { value: 9, label: '作废' }
]
const styleParents = computed(() => styles.value.filter((item) => !item.parentId))
const styleChildren = computed(() => styles.value.filter((item) => item.parentId === form.styleParentId))

function blankForm() {
  return { memberId: null, customerName: '', customerPhone: '', customerSex: 0, goodsName: '', styleParentId: null, styleItemId: null, materialItemId: null, metalItemId: null, weight: null, expectPrice: 0, depositAmount: null, customDate: today(), remark: '' }
}
function today() {
  const d = new Date()
  const p = (n) => String(n).padStart(2, '0')
  return d.getFullYear() + '-' + p(d.getMonth() + 1) + '-' + p(d.getDate())
}
function money(v) { return Number(v || 0).toLocaleString('zh-CN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) }
function dateText(v) { return v ? String(v).slice(0, 10) : '' }
function dateTime(v) { return v ? String(v).replace('T', ' ').slice(0, 16) : '' }
function statusText(v) { return statusOptions.find((it) => it.value === v)?.label || '草稿' }
function statusType(v) { return v === 1 ? 'success' : v === 2 ? 'warning' : v === 8 || v === 9 ? 'info' : '' }
function ledgerText(v) { return { 1: '收定金', 2: '销售对冲', 3: '作废退回', 4: '退定金' }[v] || '变动' }
function metaText(row) { return [row.styleItemName, row.materialName, row.metalName].filter(Boolean).join(' · ') || '未填写属性' }

async function loadOptions() {
  const [styleRes, materialRes, metalRes] = await Promise.all([lookupOptions('style'), lookupOptions('material'), lookupOptions('metal')])
  styles.value = styleRes.data || []
  materials.value = (materialRes.data || []).filter((item) => !item.parentId)
  metals.value = (metalRes.data || []).filter((item) => !item.parentId)
}
async function load() {
  loading.value = true
  try {
    query.beginTime = dateRange.value?.[0] || null
    query.endTime = dateRange.value?.[1] || null
    const res = await listCustom(query)
    rows.value = res.data?.result || []
    total.value = res.data?.totalNum || 0
  } finally { loading.value = false }
}
function search() { query.pageNum = 1; load() }
function openEditor() { Object.assign(form, blankForm()); editor.value = true }
async function identify() {
  const keyword = (form.customerPhone || form.customerName || '').trim()
  if (!keyword) return
  const res = await matchSaleCustomer(keyword)
  const data = res.data || {}
  const one = data.memberId ? data : (data.candidates || [])[0]
  if (!one?.memberId && !data.exists) { form.memberId = null; ElMessage.info('未找到会员，按新客户收定金'); return }
  const member = data.memberId ? data : one
  form.memberId = member.memberId
  form.customerName = member.memberName || form.customerName
  form.customerPhone = member.phone || form.customerPhone
  form.customerSex = member.sex ?? form.customerSex
  ElMessage.success('已识别库内会员')
}
async function submit() {
  await formRef.value?.validate()
  saving.value = true
  try {
    await saveCustom({ ...form, weight: form.weight || null, styleParentId: undefined })
    ElMessage.success('定金已入账')
    editor.value = false
    search()
  } finally { saving.value = false }
}
async function openDetail(row) {
  const res = await getCustom(row.id)
  detail.value = res.data
  detailOpen.value = true
}
onMounted(() => { loadOptions().catch(() => {}); load() })
</script>

<style scoped>
.jy-custom { height: 100%; min-height: 100%; display: flex; flex-direction: column; gap: 8px; padding: 10px 12px 12px; background: #fbf7f8; color: #3d3236; }
.page-bar, .filter-line, .sheet { background: #fff; border: 1px solid #f0e1e5; border-radius: 10px; }
.page-bar { display: flex; align-items: center; justify-content: space-between; padding: 8px 12px; }
.page-bar h1 { margin: 0; font-size: 16px; font-weight: 650; }
.bar-actions, .filter-line { display: flex; align-items: center; gap: 8px; }
.filter-line { padding: 8px 10px; }
.filter-line .el-input, .filter-line .el-select { width: 220px; }
.count { margin-left: auto; color: #8d737b; font-size: 12px; }
.sheet { flex: 1; min-height: 0; display: flex; flex-direction: column; padding: 0 0 8px; }
.sheet .el-table { flex: 1; }
.pager { display: flex; justify-content: flex-end; padding: 8px 10px 0; }
.stack { display: flex; flex-direction: column; line-height: 1.35; }
.stack small { color: #8d737b; }
.remain { color: #a85c6e; }
.form-grid { display: grid; grid-template-columns: 1fr 1fr; column-gap: 12px; }
.span-2 { grid-column: span 2; }
.form-grid :deep(.el-input-number), .form-grid :deep(.el-select), .form-grid :deep(.el-date-editor) { width: 100%; }
.detail-head { display: flex; flex-direction: column; gap: 4px; margin-bottom: 16px; }
.detail-head span, .el-timeline p { color: #8d737b; font-size: 12px; }
</style>
