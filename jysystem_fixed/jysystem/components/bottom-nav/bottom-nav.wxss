button,
button:not([size='mini']) {
  width: auto;
  margin: 0;
  border: 0;
  background: transparent;
  color: inherit;
  font-weight: inherit;
  font-size: inherit;
  line-height: inherit;
  font-family: inherit;
}
button::after { display: none; border: 0; }
.bottom-nav {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 50;
  display: flex; align-items: stretch;
  padding: 10rpx 12rpx calc(10rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--line);
  background: var(--surface-strong);
  box-shadow: 0 -14rpx 40rpx rgba(60,40,39,.12), inset 0 2rpx 0 rgba(255,255,255,.75);
  backdrop-filter: blur(30rpx); -webkit-backdrop-filter: blur(30rpx);
}
.bottom-nav > .tab-item,
button.tab-item,
.tab-item {
  position: relative;
  display: flex; flex: 1 1 20%; width: 20%; flex-direction: column; align-items: center; justify-content: center; gap: 4rpx;
  min-height: 112rpx; margin: 0; padding: 12rpx 6rpx;
  border: 0; border-radius: 24rpx;
  background: transparent; color: var(--muted);
  font-size: 21rpx; letter-spacing: 0; line-height: 1.35;
  transition: color .2s ease, background .2s ease, transform .2s ease;
}
.tab-item:active { transform: scale(.94); }
.tab-item.active {
  color: var(--jade); font-weight: 700;
  background: var(--jade-soft);
}
.tab-item.active::before {
  content: ""; position: absolute; top: 4rpx; left: 50%;
  width: 34rpx; height: 4rpx; margin-left: -17rpx;
  border-radius: 99rpx; background: var(--jade);
}
.tab-icon { font-size: 32rpx; line-height: 1; }
.tab-label { max-width: 100%; line-height: 1.3; text-align: center; white-space: normal; overflow-wrap: anywhere; }
.safe-area { display: none; }
