button,
button:not([size='mini']) {
  width: auto;
  min-height: 0;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  color: inherit;
  font-weight: inherit;
  font-size: inherit;
  line-height: inherit;
  font-family: inherit;
}
button::after { display: none; border: 0; }
.state-view {
  padding: 64rpx 30rpx; text-align: center;
  border: 1rpx dashed var(--line); border-radius: 28rpx;
  background: var(--surface-soft);
  backdrop-filter: blur(20rpx); -webkit-backdrop-filter: blur(20rpx);
}
.state-mark {
  display: flex; align-items: center; justify-content: center; width: 76rpx; height: 76rpx; margin: 0 auto 20rpx;
  border: 1rpx solid var(--line); border-radius: 50%;
  background: var(--jade-soft); color: var(--jade); font-size: 30rpx;
}
.state-error .state-mark { color: var(--red); background: var(--red-soft); }
.state-title { color: var(--ink); font-family: "Songti SC","STSong",serif; font-size: 29rpx; font-weight: 700; letter-spacing: 1rpx; }
.state-detail { margin-top: 12rpx; color: var(--muted); font-size: 22rpx; line-height: 1.65; overflow-wrap: anywhere; opacity: .9; }
button.state-action,
.state-action {
  display: inline-flex; align-items: center; justify-content: center;
  width: auto; max-width: 100%; min-height: 72rpx; margin-top: 22rpx; padding: 14rpx 34rpx;
  border: 1rpx solid var(--jade); border-radius: 999rpx;
  background: var(--jade-soft); color: var(--jade); font-size: 23rpx; font-weight: 700; line-height: 1.45;
  text-align: center; white-space: normal; overflow-wrap: anywhere; box-sizing: border-box;
}
