.member-actions {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10rpx;
  margin-top: 16rpx;
  padding-top: 14rpx;
  border-top: 1rpx dashed var(--line);
}
.member-actions .btn-mini {
  width: 100%;
  min-width: 0;
  min-height: 72rpx;
  padding: 12rpx 6rpx;
  font-size: 21rpx;
  white-space: nowrap;
}
.glass-card > .row:last-child { flex-wrap: wrap; gap: 10rpx; }
.member-title-row { row-gap: 6rpx; }
.member-name-row { flex: 1 1 260rpx; gap: 8rpx 12rpx; }
.member-name { min-width: 0; line-height: 1.45; overflow-wrap: anywhere; }
.member-points { flex: none; line-height: 1.5; white-space: nowrap; }
@media screen and (max-width: 360px) {
  .member-actions { gap: 8rpx; }
  .member-actions .btn-mini { font-size: 20rpx; }
}
