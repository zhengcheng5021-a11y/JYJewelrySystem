<app-nav title="定制预定" back="{{true}}"></app-nav>
<view class="app-page" style="{{theme.style}}">
  <view class="top-bar"><theme-switch bind:change="onTheme"></theme-switch><text class="top-meta" bindtap="load">刷新定制单 ↻</text></view>
  <view class="page-head">
    <view><view class="eyebrow-row"><text class="seal-dot"></text><text class="eyebrow">BESPOKE ORDERS</text></view><view class="page-title">定制预定</view><view class="page-sub">登记定金、追踪工坊进度，到货与尾款在同一处处理。</view></view>
    <view class="head-btn-group"><button class="head-action gold" bindtap="openCreate">＋ 收定金</button><text class="tag">{{totalText}} 单</text></view>
  </view>
  <view class="seg-tabs"><button class="seg-tab {{filter==='all'?'active':''}}" data-filter="all" bindtap="setFilter">全部定制</button><button class="seg-tab {{filter==='waiting'?'active':''}}" data-filter="waiting" bindtap="setFilter">待到货</button><button class="seg-tab {{filter==='contact'?'active':''}}" data-filter="contact" bindtap="setFilter">待联系客户</button><button class="seg-tab {{filter==='arrived'?'active':''}}" data-filter="arrived" bindtap="setFilter">已到货</button></view>
  <view class="row search-row" style="margin-bottom:18rpx;"><input class="input-mini grow" value="{{keyword}}" placeholder="客户、货品或定制单号" placeholder-class="placeholder" bindinput="onKeyword" bindconfirm="load" /><button class="btn-mini primary" bindtap="load">搜索</button></view>
  <view wx:if="{{loading && !allRows.length}}" class="state"><view class="state-title">正在读取定制单</view><view>同步工坊与门店进度。</view></view>
  <view wx:elif="{{error && !allRows.length}}" class="state" bindtap="load"><view class="state-title">定制单加载失败</view><view>{{error}}</view><text class="state-action">重试</text></view>
  <view wx:elif="{{!rows.length}}" class="state" bindtap="openCreate"><view class="state-title">这一栏暂无定制单</view><view>切换上方状态，或先收一笔定制定金。</view><text class="state-action">＋ 收定金</text></view>
  <view wx:else>
    <view wx:for="{{rows}}" wx:key="id" class="glass-card">
      <view class="row-between custom-title-row" data-id="{{item.id}}" bindtap="openDetail"><text class="serif custom-name" style="font-size:28rpx;font-weight:700;">{{item.customerText}} · {{item.goodsText}}</text><text class="tag {{item.arrived?'':'tag-gold'}}">{{item.statusText}}</text></view>
      <view class="muted small" style="margin-top:7rpx;">单号：{{item.customNo || '未编号'}} · 预计取货 {{item.pickupText}}</view>
      <view class="muted small" style="margin-top:5rpx;">{{item.metaText}} · {{item.arrivalText}}</view>
      <view class="custom-money">
        <view class="row-between small"><text>已付定金 <text class="money">¥{{item.depositText}}</text></text><text style="color:var(--gold);">待结尾款 <text class="money">¥{{item.remainText}}</text></text></view>
        <view class="progress-track" style="margin-top:12rpx;"><view class="progress-fill" style="width:{{item.progress}}%;"></view></view>
      </view>
      <view class="row action-row custom-actions">
        <button wx:if="{{item.canEdit}}" class="btn-mini" data-id="{{item.id}}" bindtap="openEdit">修改</button>
        <button wx:if="{{!item.arrived}}" class="btn-mini" data-id="{{item.id}}" bindtap="openArrival">登记到货</button>
        <button wx:if="{{item.canRefund}}" class="btn-mini danger" data-id="{{item.id}}" bindtap="openRefund">退定金</button>
        <button wx:if="{{item.canDelete}}" class="btn-mini danger" data-id="{{item.id}}" bindtap="remove">删除</button>
        <button wx:if="{{item.contactPending}}" class="btn-mini" data-id="{{item.id}}" bindtap="openDetail">联系客户</button>
        <button class="btn-mini primary" data-id="{{item.id}}" bindtap="payRemain">去结尾款 ›</button>
      </view>
    </view>
    <view wx:if="{{rows.length}}" class="pager-bar">
      <view class="pager-info">当前筛选共 {{rows.length}} 单 · 已加载 {{allRows.length}} / {{totalText}} 单（第 {{pageNum}} 页）</view>
      <view class="pager-actions">
        <button wx:if="{{hasMore}}" class="pager-btn" loading="{{loadingMore}}" bindtap="loadMore">{{loadingMore ? '加载中...' : '加载更多定制单 ↓'}}</button>
        <text wx:else class="muted small">—— 已展示全部定制单 ——</text>
        <button wx:if="{{pageNum > 1 || rows.length > 8}}" class="pager-btn" bindtap="scrollTop">回到顶部 ↑</button>
      </view>
    </view>
  </view>
  <view wx:if="{{error && allRows.length}}" class="glass-card small" style="color:var(--red);">{{error}}</view>
</view>

<view wx:if="{{editorOpen}}" class="drawer-mask" bindtap="closeEditor">
  <view class="drawer-sheet custom-sheet fixed-footer-sheet" catchtap="noop">
    <view class="drawer-handle"></view>
    <view class="drawer-head"><text class="drawer-title">{{editingId ? '修改定制单' : '收取定制定金'}}</text><button class="btn-mini" bindtap="closeEditor">关闭 ×</button></view>
    <view class="drawer-list drawer-scroll-body">
      <view class="form-section"><text class="form-section-title">客户信息</text><view class="form-grid">
        <input class="input-mini" value="{{form.customerName}}" data-field="customerName" placeholder="客户姓名（必填）" placeholder-class="placeholder" bindinput="onForm" />
        <input class="input-mini" type="number" value="{{form.customerPhone}}" data-field="customerPhone" placeholder="客户手机号（必填）" placeholder-class="placeholder" bindinput="onForm" />
      </view>
      <view class="row" style="gap:10rpx;flex-wrap:wrap;"><button class="btn-mini {{form.customerSex===0?'primary':''}}" data-value="0" bindtap="pickSex">未知</button><button class="btn-mini {{form.customerSex===1?'primary':''}}" data-value="1" bindtap="pickSex">先生</button><button class="btn-mini {{form.customerSex===2?'primary':''}}" data-value="2" bindtap="pickSex">女士</button></view></view>

      <view class="form-section"><text class="form-section-title">定制货品</text><view class="form-grid">
        <input class="input-mini" value="{{form.goodsName}}" data-field="goodsName" placeholder="定制货品名称（必填）" placeholder-class="placeholder" bindinput="onForm" />
        <input class="input-mini" value="{{form.goodsNo}}" data-field="goodsNo" placeholder="绑定货号（选填）" placeholder-class="placeholder" bindinput="onForm" />
        <input class="input-mini" value="{{form.barcode}}" data-field="barcode" placeholder="绑定条码（选填）" placeholder-class="placeholder" bindinput="onForm" />
        <view class="form-pick-row"><picker class="grow" mode="selector" range="{{options.styles}}" range-key="displayName" data-field="styleItemId" data-list="styles" bindchange="pickOption"><view class="field-line"><text class="field-label">款式分类</text><text class="field-value">{{form.styleItemIdText || '选择'}} ›</text></view></picker><button wx:if="{{form.styleItemId}}" class="btn-mini" data-field="styleItemId" bindtap="clearOption">清空</button></view>
        <view class="form-pick-row"><picker class="grow" mode="selector" range="{{options.materials}}" range-key="displayName" data-field="materialItemId" data-list="materials" bindchange="pickOption"><view class="field-line"><text class="field-label">材质</text><text class="field-value">{{form.materialItemIdText || '选择'}} ›</text></view></picker><button wx:if="{{form.materialItemId}}" class="btn-mini" data-field="materialItemId" bindtap="clearOption">清空</button></view>
        <view class="form-pick-row"><picker class="grow" mode="selector" range="{{options.metals}}" range-key="displayName" data-field="metalItemId" data-list="metals" bindchange="pickOption"><view class="field-line"><text class="field-label">金属成色</text><text class="field-value">{{form.metalItemIdText || '选择'}} ›</text></view></picker><button wx:if="{{form.metalItemId}}" class="btn-mini" data-field="metalItemId" bindtap="clearOption">清空</button></view>
        <input class="input-mini" type="digit" value="{{form.weight}}" data-field="weight" placeholder="克重（选填）" placeholder-class="placeholder" bindinput="onForm" />
        <input class="input-mini" type="digit" value="{{form.expectPrice}}" data-field="expectPrice" placeholder="预计售价（¥）" placeholder-class="placeholder" bindinput="onForm" />
      </view></view>

      <view class="form-section"><text class="form-section-title">定金与交付</text><view class="form-grid">
        <input class="input-mini" type="digit" disabled="{{editingId ? true : false}}" value="{{form.depositAmount}}" data-field="depositAmount" placeholder="本次收取定金（¥，必填）" placeholder-class="placeholder" bindinput="onForm" />
        <picker mode="date" value="{{form.customDate}}" bindchange="onCustomDate"><view class="field-line"><text class="field-label">定制日期</text><text class="field-value">{{form.customDate || '选择日期'}} ›</text></view></picker>
        <picker mode="date" value="{{form.pickupDate}}" bindchange="onPickupDate"><view class="field-line"><text class="field-label">约定取货</text><text class="field-value">{{form.pickupDate || '暂不约定'}} ›</text></view></picker>
        <input class="input-mini" value="{{form.remark}}" data-field="remark" placeholder="工期、改款要求或取货备注" placeholder-class="placeholder" bindinput="onForm" />
      </view></view>
      <view class="muted small">{{editingId ? '已收定金不能直接改金额；如需调整，请关闭后使用“退定金”。' : (form.goodsNo || form.barcode ? '已绑定在库货品，保存后直接标记到店，并进入待联系客户。' : '未绑定在库货品，保存后进入待到货；货品到店后再登记。')}}</view>
      <view wx:if="{{formError}}" class="small" style="color:var(--red);">{{formError}}</view>
    </view>
    <view class="drawer-fixed-footer"><view class="row custom-submit"><button class="btn btn-secondary" bindtap="closeEditor">取消</button><button class="btn btn-primary" loading="{{saving}}" bindtap="saveCustom">{{editingId ? '保存修改' : '保存并收定金'}}</button></view></view>
  </view>
</view>

<view wx:if="{{arrivalOpen}}" class="drawer-mask" bindtap="closeArrival">
  <view class="drawer-sheet" catchtap="noop">
    <view class="drawer-handle"></view>
    <view class="drawer-head"><text class="drawer-title">登记到货</text><button class="btn-mini" bindtap="closeArrival">关闭 ×</button></view>
    <view wx:if="{{arrivalRow}}" class="soft-panel" style="margin-bottom:16rpx;"><view class="small" style="font-weight:700;">{{arrivalRow.customerText}} · {{arrivalRow.goodsText}}</view><view class="muted small" style="margin-top:5rpx;">{{arrivalRow.customNo}} · {{arrivalRow.metaText}}</view></view>
    <view class="drawer-list">
      <input class="input-mini" value="{{arrivalBarcode}}" placeholder="扫描或输入货品唯一条码（必填）" placeholder-class="placeholder" bindinput="onArrivalBarcode" />
      <input class="input-mini" value="{{arrivalRemark}}" placeholder="到货备注（选填）" placeholder-class="placeholder" bindinput="onArrivalRemark" />
      <button class="btn btn-primary" loading="{{arrivalSaving}}" bindtap="submitArrival">确认到货</button>
    </view>
  </view>
</view>

<view wx:if="{{refundOpen}}" class="drawer-mask" bindtap="closeRefund">
  <view class="drawer-sheet fixed-footer-sheet" catchtap="noop">
    <view class="drawer-handle"></view>
    <view class="drawer-head"><text class="drawer-title">退回定制定金</text><button class="btn-mini" bindtap="closeRefund">关闭 ×</button></view>
    <view class="drawer-scroll-body">
      <view wx:if="{{refundRow}}" class="soft-panel" style="margin-bottom:16rpx;"><view class="small" style="font-weight:700;">{{refundRow.customerText}} · {{refundRow.goodsText}}</view><view class="muted small" style="margin-top:5rpx;">可退余额 ¥{{refundRow.remainText}}</view></view>
      <view class="drawer-list">
      <input class="input-mini" type="digit" value="{{refundAmount}}" placeholder="退款金额（¥）" placeholder-class="placeholder" bindinput="onRefundAmount" />
      <input class="input-mini" value="{{refundRemark}}" placeholder="退款原因 / 备注（选填）" placeholder-class="placeholder" bindinput="onRefundRemark" />
      <view class="muted small">退款只冲减剩余定金；退清后绑定商品会自动解锁，流水会保留。</view>
      </view>
    </view>
    <view class="drawer-fixed-footer"><view class="row custom-submit"><button class="btn btn-secondary" loading="{{refundSaving}}" bindtap="refundAll">退清全部</button><button class="btn btn-danger" loading="{{refundSaving}}" bindtap="submitRefund">确认退定金</button></view></view>
  </view>
</view>

<view wx:if="{{detailOpen}}" class="drawer-mask" bindtap="closeDetail">
  <view class="drawer-sheet" catchtap="noop">
    <view class="drawer-handle"></view>
    <view class="drawer-head"><text class="drawer-title">定金流水</text><button class="btn-mini" bindtap="closeDetail">关闭 ×</button></view>
    <view wx:if="{{detail}}" class="soft-panel"><view class="small" style="font-weight:700;">{{detail.customNo}} · {{detail.customerText}}</view><view class="muted small" style="margin-top:5rpx;">{{detail.goodsText}} · 剩余 ¥{{detail.remainText}}</view></view>
    <view wx:if="{{detailLoading}}" class="state"><view class="state-title">正在读取流水</view></view>
    <view wx:elif="{{detailLedgers.length}}" class="drawer-list" style="margin-top:16rpx;">
      <view wx:for="{{detailLedgers}}" wx:key="id" class="drawer-item"><view class="row-between"><text class="small" style="font-weight:700;">{{item.changeText}}</text><text class="money small">¥{{item.amountText}}</text></view><view class="muted small" style="margin-top:5rpx;">{{item.timeText}} · 余额 ¥{{item.balanceText}}</view><view class="muted small" style="margin-top:4rpx;">{{item.remark || '无备注'}}</view></view>
    </view>
    <view wx:else class="state"><view class="state-title">暂无定金流水</view></view>
  </view>
</view>
<bottom-nav active=""></bottom-nav>
